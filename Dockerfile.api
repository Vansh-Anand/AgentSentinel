FROM public.ecr.aws/docker/library/python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-dashboard.txt requirements-gemini.txt /app/
RUN python -m pip install --no-cache-dir -r requirements-gemini.txt
COPY . /app
RUN mkdir -p /app/.data && chown -R 10001:10001 /app
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "dashboard_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
